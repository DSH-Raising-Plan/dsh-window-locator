{
  "name": "dsh-window-locator",
  "version": "0.1.0",
  "description": "Windows monitor geometry + foreground window (physical pixels) as DeepSeek Harness tools.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "windows", "monitor", "foreground"],
  "homepage": "https://github.com/canyueY/dsh-window-locator#readme",
  "bugs": { "url": "https://github.com/canyueY/dsh-window-locator/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyueY/dsh-window-locator.git"
  },
  "author": "canyueY",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./win32": "./src/win32.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/win32.js && node --check src/tool-spec.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
