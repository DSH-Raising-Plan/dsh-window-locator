    "url": "https://github.com/DSH-Raising-Plan/dsh-window-locator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSH-Raising-Plan/dsh-window-locator.git"
  },
  "author": "canyueY",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./win32": "./src/win32.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
